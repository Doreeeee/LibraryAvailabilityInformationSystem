rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Users Collection ----------
    match /users/{userId} {
      allow create, read, update, delete: if true;
    }

    // ---------- Books Collection ----------
    match /books/{bookId} {
      allow create, read, update, delete: if true;
    }

    // ---------- System Logs & Activities ----------
    match /activities/{activityId} {
      allow read, write: if true;
    }

    match /logs/{logId} {
      allow read, write: if true;
    }
  }
}
